#!/usr/bin/env bash
set -u

print_only=0
if [[ "${1:-}" == "--print" ]]; then
    print_only=1
    shift
fi

candidate="${1:-}"

dev="$(
    nmcli -t -f DEVICE,TYPE,STATE device status 2>/dev/null |
        awk -F: '$2=="wifi" && $3=="connected" {print $1; exit}'
)"
[[ -n "$dev" ]] || exit 0

connection="$(nmcli -g GENERAL.CONNECTION device show "$dev" 2>/dev/null | head -n1)"
[[ -n "$connection" && "$connection" != "--" ]] || exit 0

still_connected() {
    [[ "$(nmcli -g GENERAL.CONNECTION device show "$dev" 2>/dev/null | head -n1)" == "$connection" ]]
}

is_probe_url() {
    case "$1" in
        ""|\
        http://ping.archlinux.org/*|https://ping.archlinux.org/*|\
        http://connectivitycheck.gstatic.com/*|https://connectivitycheck.gstatic.com/*|\
        http://www.msftconnecttest.com/*|https://www.msftconnecttest.com/*|\
        http://detectportal.firefox.com/*|https://detectportal.firefox.com/*|\
        http://captive.apple.com/*|https://captive.apple.com/*|\
        http://example.com/*|https://example.com/*)
            return 0 ;;
        *)  return 1 ;;
    esac
}

open_target() {
    local target="$1"
    if [[ "$print_only" -eq 1 ]]; then
        printf '%s\n' "$target"
    else
        xdg-open "$target" >/dev/null 2>&1 &
    fi
    exit 0
}

if [[ "$candidate" =~ ^https?:// ]] && ! is_probe_url "$candidate"; then
    open_target "$candidate"
fi

tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

probe_one() {
    local id="$1" url="$2"
    local headers="$tmp/$id.headers" body="$tmp/$id.body" loc body_url

    curl --noproxy '*' --interface "$dev" -sS \
        -A 'Mozilla/5.0 (X11; Linux x86_64; rv:154.0) Gecko/20100101 Firefox/154.0' \
        -H 'Cache-Control: no-cache' \
        --connect-timeout 1 --max-time 2 \
        -D "$headers" -o "$body" "$url" >/dev/null 2>&1 || true

    loc="$(sed -n 's/^[Ll]ocation:[[:space:]]*//p' "$headers" 2>/dev/null | tr -d '\r' | head -n1)"
    if [[ "$loc" =~ ^https?:// ]] && ! is_probe_url "$loc"; then
        printf '%s\n' "$loc" > "$tmp/$id.found"
        return
    fi

}

discover_once() {
    rm -f "$tmp"/*.found "$tmp"/*.headers "$tmp"/*.body 2>/dev/null || true
    local stamp
    stamp="$(date +%s)"

    probe_one firefox "http://detectportal.firefox.com/success.txt?cp=$stamp" &
    probe_one apple "http://captive.apple.com/hotspot-detect.html?cp=$stamp" &
    probe_one msft "http://www.msftconnecttest.com/connecttest.txt?cp=$stamp" &
    probe_one arch "http://ping.archlinux.org/nm-check.txt?cp=$stamp" &
    probe_one google "http://connectivitycheck.gstatic.com/generate_204?cp=$stamp" &
    wait

    local f url
    for f in "$tmp"/*.found; do
        [[ -f "$f" ]] || continue
        url="$(head -n1 "$f")"
        if [[ "$url" =~ ^https?:// ]] && ! is_probe_url "$url"; then
            printf '%s\n' "$url"
            return 0
        fi
    done
    return 1
}

for _attempt in {1..8}; do
    still_connected || exit 0
    target="$(discover_once || true)"
    if [[ -n "$target" ]]; then
        open_target "$target"
    fi
    sleep 1
done

if [[ "$print_only" -eq 1 ]]; then
    printf 'NOT_FOUND\n'
else
    notify-send -a Caelestia -i network-wireless \
        'Wi-Fi sign-in' \
        'The network looks captive, but its login page did not answer yet. I will not open a random test page.' \
        >/dev/null 2>&1 || true
fi
