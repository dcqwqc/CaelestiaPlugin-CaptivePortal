#!/usr/bin/env bash
set -u

print_only=0
if [[ "${1:-}" == "--print" ]]; then
    print_only=1
    shift
fi

candidate="${1:-}"

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/caelestia"
log_file="$state_dir/captive-portal.log"
mkdir -p "$state_dir" 2>/dev/null || true

log() {
    printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >> "$log_file" 2>/dev/null || true
}

# Detached helpers normally inherit Caelestia's Wayland environment. If they
# are invoked elsewhere, import the GUI variables from the user systemd manager.
for key in DISPLAY WAYLAND_DISPLAY XDG_RUNTIME_DIR DBUS_SESSION_BUS_ADDRESS XDG_CURRENT_DESKTOP XDG_SESSION_TYPE; do
    if [[ -z "${!key:-}" ]]; then
        value="$(systemctl --user show-environment 2>/dev/null | sed -n "s/^${key}=//p" | head -n1)"
        [[ -n "$value" ]] && export "$key=$value"
    fi
done

dev="$(
    nmcli -t -f DEVICE,TYPE,STATE device status 2>/dev/null |
        awk -F: '$2=="wifi" && $3=="connected" {print $1; exit}'
)"
[[ -n "$dev" ]] || {
    log "click: no connected Wi-Fi device"
    exit 0
}

connection="$(nmcli -g GENERAL.CONNECTION device show "$dev" 2>/dev/null | head -n1)"
ssid="$(nmcli -t -f ACTIVE,SSID dev wifi 2>/dev/null | sed -n 's/^yes://p' | head -n1)"
[[ -n "$connection" && "$connection" != "--" ]] || {
    log "click: Wi-Fi device has no active connection"
    exit 0
}

log "click: ssid=$ssid connection=$connection candidate=${candidate:-<none>}"

still_connected() {
    [[ "$(nmcli -g GENERAL.CONNECTION device show "$dev" 2>/dev/null | head -n1)" == "$connection" ]]
}

is_probe_url() {
    case "$1" in
        ""|\
        http://ping.archlinux.org/*|https://ping.archlinux.org/*|\
        http://connectivitycheck.gstatic.com/*|https://connectivitycheck.gstatic.com/*|\
        http://www.msftconnecttest.com/*|https://www.msftconnecttest.com/*|\
        http://detectportal.firefox.com/*|https://detectportal.firefox.com/*|\
        http://captive.apple.com/*|https://captive.apple.com/*|\
        http://httpbin.org/*|https://httpbin.org/*|\
        http://httpbingo.org/*|https://httpbingo.org/*|\
        http://cp.cloudflare.com/*|https://cp.cloudflare.com/*|\
        http://www.rewe.de/*|https://www.rewe.de/*|\
        http://example.com/*|https://example.com/*)
            return 0 ;;
        *)  return 1 ;;
    esac
}

open_target() {
    local target="$1"
    log "open: target=$target"

    if [[ "$print_only" -eq 1 ]]; then
        printf '%s\n' "$target"
        exit 0
    fi

    # Zen is installed as a Flatpak on Mirai. Launch it directly so opening a
    # portal does not depend on xdg-open desktop-environment detection.
    if flatpak info app.zen_browser.zen >/dev/null 2>&1; then
        if /usr/bin/flatpak run --branch=stable --arch=x86_64             --command=launch-script.sh app.zen_browser.zen "$target"             >>"$log_file" 2>&1 &
        then
            log "open: dispatched to Zen Flatpak"
            exit 0
        fi
    fi

    if command -v gio >/dev/null 2>&1; then
        if gio open "$target" >>"$log_file" 2>&1 & then
            log "open: dispatched through gio"
            exit 0
        fi
    fi

    if [[ -x /usr/bin/xdg-open ]]; then
        /usr/bin/xdg-open "$target" >>"$log_file" 2>&1 &
        log "open: dispatched through /usr/bin/xdg-open"
        exit 0
    fi

    log "open: no browser launcher available"
    notify-send -a Caelestia -i network-wireless         'Wi-Fi sign-in' 'Could not open the browser.' >/dev/null 2>&1 || true
    exit 1
}

# A concrete captive URL from the detector wins immediately.
if [[ "$candidate" =~ ^https?:// ]] && ! is_probe_url "$candidate"; then
    open_target "$candidate"
fi

tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

probe_one() {
    local id="$1" url="$2"
    local headers="$tmp/$id.headers" body="$tmp/$id.body" loc

    curl --noproxy '*' --interface "$dev" -sS         -A 'Mozilla/5.0 (X11; Linux x86_64; rv:154.0) Gecko/20100101 Firefox/154.0'         -H 'Cache-Control: no-cache'         --connect-timeout 1 --max-time 2         -D "$headers" -o "$body" "$url" >/dev/null 2>&1 || true

    loc="$(sed -n 's/^[Ll]ocation:[[:space:]]*//p' "$headers" 2>/dev/null | tr -d '\r' | head -n1)"
    if [[ "$loc" =~ ^https?:// ]] && ! is_probe_url "$loc"; then
        printf '%s\n' "$loc" > "$tmp/$id.found"
    fi
}

discover_once() {
    rm -f "$tmp"/*.found "$tmp"/*.headers "$tmp"/*.body 2>/dev/null || true
    local stamp f url
    stamp="$(date +%s)"

    probe_one firefox "http://detectportal.firefox.com/success.txt?cp=$stamp" &
    probe_one apple "http://captive.apple.com/hotspot-detect.html?cp=$stamp" &
    probe_one msft "http://www.msftconnecttest.com/connecttest.txt?cp=$stamp" &
    probe_one arch "http://ping.archlinux.org/nm-check.txt?cp=$stamp" &
    probe_one google "http://connectivitycheck.gstatic.com/generate_204?cp=$stamp" &

    # REWE specifically documents using an ordinary web page to trigger its
    # hotspot login. Probe its own HTTP site as an additional redirect source.
    if [[ "$ssid" == *REWE* || "$ssid" == *rewe* ]]; then
        probe_one rewe "http://www.rewe.de/?cp=$stamp" &
    fi
    wait

    for f in "$tmp"/*.found; do
        [[ -f "$f" ]] || continue
        url="$(head -n1 "$f")"
        if [[ "$url" =~ ^https?:// ]] && ! is_probe_url "$url"; then
            printf '%s\n' "$url"
            return 0
        fi
    done
    return 1
}

target="$(discover_once || true)"
if [[ -n "$target" ]]; then
    log "discovery: direct portal=$target"
    open_target "$target"
fi

still_connected || {
    log "discovery: Wi-Fi changed during click"
    exit 0
}

# REWE fallback: if the portal appliance did not expose a redirect to curl,
# open REWE over plain HTTP in the actual browser. The captive gateway can then
# intercept the browser request itself. This guarantees the button visibly does
# something while avoiding NeverSSL/example/connectivity-check pages.
if [[ "$ssid" == *REWE* || "$ssid" == *rewe* ]]; then
    log "discovery: no direct redirect; using REWE HTTP trigger"
    open_target "http://www.rewe.de/"
fi

# For other public Wi-Fi, retry briefly because some portal appliances wake up
# slowly. Do not open unrelated test pages as a fallback.
for _attempt in 1 2 3; do
    sleep 1
    still_connected || exit 0
    target="$(discover_once || true)"
    if [[ -n "$target" ]]; then
        log "discovery: retry portal=$target"
        open_target "$target"
    fi
done

log "discovery: portal URL not found"
if [[ "$print_only" -eq 1 ]]; then
    printf 'NOT_FOUND\n'
else
    notify-send -a Caelestia -i network-wireless         'Wi-Fi sign-in'         'The network looks captive, but its login page did not answer yet.'         >/dev/null 2>&1 || true
fi
